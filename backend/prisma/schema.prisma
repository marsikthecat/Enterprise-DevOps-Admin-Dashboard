// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String
  roleId    String?
  role      Role?    @relation(fields: [roleId], references: [id])
  status    String
  lastLogin DateTime
  sessions  Int
  avatar    String
  createdAt DateTime @default(now())
}

model Server {
  id        String @id @default(uuid())
  type      String
  status    String
  cpu       Int
  memory    Int
  disk      Int
  uptime    String
  network   String
  location  String
  ipAddress String
  containers Container[]
  processes   Process[]
  createdAt DateTime @default(now())
}

model Container {
  id        String @id
  image     String
  status    String
  ports     String
  serverId  String
  server    Server @relation(fields: [serverId], references: [id])
  createdAt DateTime @default(now())
}

model Process {
  id        String @id @default(uuid())
  pid       Int
  name      String
  user      String
  cpu       Float
  memory    Float
  threads   Int
  status    String
  serverId  String
  server    Server @relation(fields: [serverId], references: [id])
  createdAt DateTime @default(now())
  uptime    String
}

model Pipeline {
  id      String   @id @default(uuid())
  name    String
  image   String
  status  String
  lastRun DateTime
}

model Alert {
  id          String @id @default(uuid())
  severity    String
  title       String
  description String
  time        String
  status      String
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  editable    Boolean
  users       User[]
  permissions Permission[]
}

model Permission {
  id       String @id @default(uuid())
  key      String
  name     String
  category String
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])
}

model StorageRegion {
  id          String @id @default(uuid())
  region      String @unique
  totalMemory Float
  usedMemory  Float
  files       Int
  lat         Int
  lng         Int
}

model RecentUpload {
  id         String @id @default(uuid())
  fileName   String @unique
  fileSize   Float
  uploadedAt String
  uploadedBy String
  status     String
}

model RecentAlert {
  id          String @id @default(uuid())
  severity    String
  title       String
  description String
  time        String
  status      String
}

model Vulnerability {
  id          String @id @default(uuid())
  package     String
  version     String
  severity    String
  cve         String
  serverCount Int
}

model AuditLogEntry {
  id          String @id @default(uuid())
  timeStamp   String @unique
  action      String
  author      String
}